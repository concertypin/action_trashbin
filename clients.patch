diff --git a/libs/common/src/platform/services/fido2/credential-profile-utils.ts b/libs/common/src/platform/services/fido2/credential-profile-utils.ts
new file mode 100644
index 0000000..f482a19
--- /dev/null
+++ b/libs/common/src/platform/services/fido2/credential-profile-utils.ts
@@ -0,0 +1,79 @@
+import { guidToStandardFormat } from "./guid-utils";
+
+export const CredentialProfiles = {
+  Legacy: "legacy",
+  PlatformV1: "profile-v1/platform",
+  RoamingSecurityKeyV1: "profile-v1/roaming-security-key",
+} as const;
+
+export type CredentialProfile = (typeof CredentialProfiles)[keyof typeof CredentialProfiles];
+export type VersionOneCredentialProfile = Exclude<CredentialProfile, "legacy">;
+export type CredentialAttachment = "platform" | "cross-platform";
+export type CredentialTransport = "ble" | "hybrid" | "internal" | "nfc" | "usb";
+
+/**
+ * The marker is 24 fixed prefix bits, a 2-bit signature, and a 2-bit profile
+ * code, leaving 100 random bits in the 16-byte credential ID. Keep the legacy
+ * roaming code compatible with the initial browser prototype marker (`BWP`,
+ * high nibble A).
+ */
+const PROFILE_PREFIX = new Uint8Array([0x42, 0x57, 0x50]); // ASCII "BWP"
+const PROFILE_SIGNATURE_MASK = 0xc0;
+const PROFILE_SIGNATURE = 0x80;
+const PROFILE_VARIANT_MASK = 0x30;
+const PROFILE_VARIANTS: Record<VersionOneCredentialProfile, number> = {
+  [CredentialProfiles.PlatformV1]: 0x10,
+  [CredentialProfiles.RoamingSecurityKeyV1]: 0x20,
+};
+
+/** Create a marked 16-byte credential ID, represented in Bitwarden's existing UUID field. */
+export function generateCredentialId(profile: VersionOneCredentialProfile): string {
+  const rawId = new Uint8Array(16);
+  crypto.getRandomValues(rawId);
+  rawId.set(PROFILE_PREFIX, 0);
+  rawId[3] = (rawId[3] & 0x0f) | PROFILE_SIGNATURE | PROFILE_VARIANTS[profile];
+
+  return guidToStandardFormat(rawId);
+}
+
+/** Classify a 16-byte credential ID; all unknown and legacy layouts remain legacy. */
+export function getCredentialProfile(credentialId: BufferSource): CredentialProfile {
+  const rawId =
+    credentialId instanceof ArrayBuffer
+      ? new Uint8Array(credentialId)
+      : new Uint8Array(credentialId.buffer, credentialId.byteOffset, credentialId.byteLength);
+
+  if (
+    rawId.byteLength !== 16 ||
+    rawId[0] !== PROFILE_PREFIX[0] ||
+    rawId[1] !== PROFILE_PREFIX[1] ||
+    rawId[2] !== PROFILE_PREFIX[2] ||
+    (rawId[3] & PROFILE_SIGNATURE_MASK) !== PROFILE_SIGNATURE
+  ) {
+    return CredentialProfiles.Legacy;
+  }
+
+  switch (rawId[3] & PROFILE_VARIANT_MASK) {
+    case PROFILE_VARIANTS[CredentialProfiles.PlatformV1]:
+      return CredentialProfiles.PlatformV1;
+    case PROFILE_VARIANTS[CredentialProfiles.RoamingSecurityKeyV1]:
+      return CredentialProfiles.RoamingSecurityKeyV1;
+    default:
+      return CredentialProfiles.Legacy;
+  }
+}
+
+export function getCredentialAttachment(profile: CredentialProfile): CredentialAttachment {
+  return profile === CredentialProfiles.RoamingSecurityKeyV1 ? "cross-platform" : "platform";
+}
+
+export function getCredentialTransports(profile: CredentialProfile): CredentialTransport[] {
+  switch (profile) {
+    case CredentialProfiles.PlatformV1:
+      return ["internal"];
+    case CredentialProfiles.RoamingSecurityKeyV1:
+      return ["usb"];
+    case CredentialProfiles.Legacy:
+      return ["internal", "hybrid"];
+  }
+}
