diff --git a/apps/browser/src/autofill/fido2/utils/webauthn-utils.spec.ts b/apps/browser/src/autofill/fido2/utils/webauthn-utils.spec.ts
new file mode 100644
index 0000000..e93b2bb
--- /dev/null
+++ b/apps/browser/src/autofill/fido2/utils/webauthn-utils.spec.ts
@@ -0,0 +1,114 @@
+import {
+  AssertCredentialResult,
+  CreateCredentialResult,
+} from "@bitwarden/common/platform/abstractions/fido2/fido2-client.service.abstraction";
+import { Utils } from "@bitwarden/common/platform/misc/utils";
+import { parseCredentialId } from "@bitwarden/common/platform/services/fido2/credential-id-utils";
+import {
+  CredentialProfiles,
+  generateCredentialId,
+} from "@bitwarden/common/platform/services/fido2/credential-profile-utils";
+import { Fido2Utils } from "@bitwarden/common/platform/services/fido2/fido2-utils";
+import { guidToRawFormat } from "@bitwarden/common/platform/services/fido2/guid-utils";
+
+import { setupMockedWebAuthnSupport } from "../../spec/fido2-testing-utils";
+
+import { WebauthnUtils } from "./webauthn-utils";
+
+beforeAll(() => setupMockedWebAuthnSupport());
+
+describe("WebauthnUtils credential profile mapping", () => {
+  it("preserves an explicit platform-only registration request", () => {
+    const options = {
+      publicKey: {
+        authenticatorSelection: { authenticatorAttachment: "platform" },
+        challenge: new Uint8Array([1, 2, 3]),
+        excludeCredentials: [],
+        pubKeyCredParams: [{ alg: -7, type: "public-key" }],
+        rp: { id: "example.com", name: "Example" },
+        user: { id: new Uint8Array([4]), name: "user", displayName: "User" },
+      },
+    } as unknown as CredentialCreationOptions;
+
+    const result = WebauthnUtils.mapCredentialCreationOptions(options, true);
+
+    expect(result.authenticatorSelection?.authenticatorAttachment).toBe("platform");
+  });
+
+  it("reports a profile-v1/platform registration with internal transport", () => {
+    const rawCredentialId = parseCredentialId(generateCredentialId(CredentialProfiles.PlatformV1));
+    const result = createRegistrationResult(Fido2Utils.arrayToString(rawCredentialId), [
+      "internal",
+    ]);
+
+    const credential = WebauthnUtils.mapCredentialRegistrationResult(result);
+
+    expect(credential.authenticatorAttachment).toBe("platform");
+    expect((credential.response as AuthenticatorAttestationResponse).getTransports()).toEqual([
+      "internal",
+    ]);
+    expect(credential.toJSON().authenticatorAttachment).toBe("platform");
+  });
+
+  it("reports a profile-v1/roaming registration as cross-platform with usb transport", () => {
+    const rawCredentialId = parseCredentialId(
+      generateCredentialId(CredentialProfiles.RoamingSecurityKeyV1),
+    );
+    const result = createRegistrationResult(Fido2Utils.arrayToString(rawCredentialId), ["usb"]);
+
+    const credential = WebauthnUtils.mapCredentialRegistrationResult(result);
+
+    expect(credential.authenticatorAttachment).toBe("cross-platform");
+    expect((credential.response as AuthenticatorAttestationResponse).getTransports()).toEqual([
+      "usb",
+    ]);
+    expect(credential.toJSON().authenticatorAttachment).toBe("cross-platform");
+  });
+
+  it("keeps a legacy registration platform-attached", () => {
+    const legacyId = Fido2Utils.arrayToString(guidToRawFormat(Utils.newGuid()));
+    const credential = WebauthnUtils.mapCredentialRegistrationResult(
+      createRegistrationResult(legacyId, ["internal", "hybrid"]),
+    );
+
+    expect(credential.authenticatorAttachment).toBe("platform");
+    expect((credential.response as AuthenticatorAttestationResponse).getTransports()).toEqual([
+      "internal",
+      "hybrid",
+    ]);
+  });
+
+  it.each([
+    [CredentialProfiles.PlatformV1, "platform"],
+    [CredentialProfiles.RoamingSecurityKeyV1, "cross-platform"],
+  ] as const)("reports %s assertions as %s", (profile, attachment) => {
+    const result: AssertCredentialResult = {
+      credentialId: Fido2Utils.arrayToString(parseCredentialId(generateCredentialId(profile))),
+      clientDataJSON: "",
+      authenticatorData: "",
+      signature: "",
+      userHandle: "",
+    };
+
+    const credential = WebauthnUtils.mapCredentialAssertResult(result);
+
+    expect(credential.authenticatorAttachment).toBe(attachment);
+    expect(credential.toJSON().authenticatorAttachment).toBe(attachment);
+  });
+});
+
+function createRegistrationResult(
+  credentialId: string,
+  transports: string[],
+): CreateCredentialResult {
+  return {
+    credentialId,
+    attestationObject: "",
+    authData: "",
+    clientDataJSON: "",
+    publicKey: "",
+    publicKeyAlgorithm: -7,
+    transports,
+    extensions: {},
+  };
+}
